generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// ENUMS
// =============================================
enum Currency {
  VND
  USD
}

enum TransactionStatus {
  pending
  success
  failed
  cancelled
}

enum TransactionType {
  deposit
  withdraw
  transfer
  payment
  refund
}

enum UserRole {
  customer
  admin
  support
}

enum AdminRole {
  super_admin
  operator
  support
  finance
}

enum PaymentType {
  bill
  merchant
  subscription
}

enum TopUpMethod {
  bank_transfer
  credit_card
  debit_card
  voucher
}

enum NotificationType {
  info
  success
  warning
  error
}

// =============================================
// MODELS
// =============================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  phoneNumber      String?   @unique
  name             String
  avatar           String?
  role             UserRole  @default(customer)
  isEmailVerified  Boolean   @default(false)
  isPhoneVerified  Boolean   @default(false)
  lastLoginAt      DateTime?
  twoFactorEnabled Boolean?  @default(false)
  twoFactorSecret  String?
  passwordHash     String // Thêm trường này cho đăng nhập

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  wallets       Wallet[]
  transactions  Transaction[]
  transfersSent Transfer[]     @relation("TransferSender")
  transfersRecv Transfer[]     @relation("TransferReceiver")
  topUps        TopUp[]
  payments      Payment[]
  notifications Notification[]
  adminProfile  Admin?
  sessions      UserSession[]
  linkedBanks   LinkedBank[]

  @@map("users")
}

model Wallet {
  id                  String   @id @default(uuid())
  userId              String
  balance             Int      @default(0)
  currency            Currency @default(VND)
  accountNumber       String   @unique
  isActive            Boolean  @default(true)
  dailyLimit          Int?
  monthlyLimit        Int?
  currentDailyUsage   Int?     @default(0)
  currentMonthlyUsage Int?     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  transactions  Transaction[]
  transfersFrom Transfer[]    @relation("WalletTransferFrom")
  transfersTo   Transfer[]    @relation("WalletTransferTo")
  topUps        TopUp[]
  payments      Payment[]

  @@map("wallets")
}

model Transaction {
  id                String            @id @default(uuid())
  userId            String
  walletId          String
  fromWalletId      String?
  toWalletId        String?
  referenceCode     String?           @unique
  failureReason     String?
  recipientName     String?
  senderName        String?
  type              TransactionType
  status            TransactionStatus @default(pending)
  amount            Int
  fee               Int?              @default(0)
  currency          Currency          @default(VND)
  referenceId       String?
  description       String?
  metadata          Json?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

model Transfer {
  id                       String            @id @default(uuid())
  fromUserId               String
  toUserId                 String
  fromWalletId             String
  toWalletId               String
  amount                   Int
  fee                      Int?              @default(0)
  status                   TransactionStatus @default(pending)
  reference                String?
  transactionId            String            @unique
  counterpartTransactionId String            @unique
  completedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser   User   @relation("TransferSender", fields: [fromUserId], references: [id])
  toUser     User   @relation("TransferReceiver", fields: [toUserId], references: [id])
  fromWallet Wallet @relation("WalletTransferFrom", fields: [fromWalletId], references: [id])
  toWallet   Wallet @relation("WalletTransferTo", fields: [toWalletId], references: [id])

  @@map("transfers")
}

model TopUp {
  id                String            @id @default(uuid())
  userId            String
  walletId          String
  amount            Int
  method            TopUpMethod
  status            TransactionStatus @default(pending)
  externalReference String?
  transactionId     String            @unique
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("top_ups")
}

model Payment {
  id            String            @id @default(uuid())
  userId        String
  walletId      String
  amount        Int
  fee           Int?              @default(0)
  type          PaymentType
  merchantId    String?
  billCode      String?
  description   String?
  status        TransactionStatus @default(pending)
  transactionId String            @unique
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("payments")
}

model Notification {
  id       String           @id @default(uuid())
  userId   String
  title    String
  message  String
  type     NotificationType
  isRead   Boolean          @default(false)
  readAt   DateTime?
  link     String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Admin {
  id          String    @id @default(uuid())
  userId      String    @unique
  role        AdminRole
  permissions String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("admins")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

model SystemSetting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       Json
  description String?
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model LinkedBank {
  id            String    @id @default(uuid())
  userId        String
  bankCode      String
  accountNumber String
  accountName   String
  isDefault     Boolean   @default(false)
  isVerified    Boolean   @default(true)
  linkedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id])
  @@unique([userId, bankCode, accountNumber])
  @@map("linked_banks")
}

model GatewayTransaction {
  id                  String            @id @default(uuid())
  userId              String
  walletId            String
  transactionId       String            @unique
  gatewayTxId         String?           @unique
  type                String
  bankCode            String
  accountNumber       String
  amount              Int
  status              TransactionStatus @default(pending)
  callbackReceivedAt  DateTime?
  gatewayRef          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  @@map("gateway_transactions")
}
